# Copy to .env (git-ignored) and fill in. Never commit real values.
DATABASE_URL=postgresql+psycopg://traceline:CHANGE_ME@127.0.0.1:5432/traceline
TEST_DATABASE_URL=postgresql+psycopg://traceline:CHANGE_ME@127.0.0.1:5432/traceline_test
STORAGE_ROOT=./data

# Featherless (backend only; never expose to the browser)
FEATHERLESS_API_KEY=
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
FEATHERLESS_TEXT_MODEL=Qwen/Qwen3-14B
FEATHERLESS_VISION_MODEL=Qwen/Qwen3-VL-8B-Instruct

# Accident cue: "detr" (default; downloads ~160 MB once to <storage>/models/hf), "yolo" (older cue model) or empty to disable
ACCIDENT_BACKEND=detr
